# EvoScientist — cp .env.example .env && fill in your keys

# LLM provider (pick at least one)
# console.anthropic.com
ANTHROPIC_API_KEY=
# platform.openai.com
OPENAI_API_KEY=
# aistudio.google.com/api-keys
GOOGLE_API_KEY=
# build.nvidia.com
NVIDIA_API_KEY=

# Direct providers (optional)
# platform.minimaxi.com (China, default) or platform.minimax.io (Global)
MINIMAX_API_KEY=
# https://api.minimaxi.com/anthropic (default) or https://api.minimax.io/anthropic
MINIMAX_BASE_URL=
# open.bigmodel.cn (Zhipu)
ZHIPU_API_KEY=
# volcengine.com (Volcengine)
VOLCENGINE_API_KEY=
# dashscope.aliyuncs.com (Alibaba Cloud)
DASHSCOPE_API_KEY=
# platform.moonshot.cn (Moonshot)
MOONSHOT_API_KEY=
# kimi.com/code (Kimi Coding Plan)
KIMI_API_KEY=
# platform.xiaomimimo.com (Xiaomi MiMo, pay-as-you-go sk- key)
MIMO_API_KEY=
# platform.xiaomimimo.com/token-plan (tp- key, coding tools only)
MIMO_TOKEN_PLAN_API_KEY=
# https://token-plan-cn.xiaomimimo.com/anthropic (default); -sgp / -ams for other regions
MIMO_TOKEN_PLAN_BASE_URL=

# Aggregator platforms (optional)
# siliconflow.cn
SILICONFLOW_API_KEY=
# openrouter.ai
OPENROUTER_API_KEY=
# requesty.ai
REQUESTY_API_KEY=
# atlascloud.ai
ATLASCLOUD_API_KEY=
# novita.ai
NOVITA_API_KEY=
# opper.ai (EU-hosted gateway)
OPPER_API_KEY=

# Custom endpoints (optional)
# OpenAI-compatible endpoint
CUSTOM_OPENAI_API_KEY=
CUSTOM_OPENAI_BASE_URL=
# Anthropic-compatible endpoint
CUSTOM_ANTHROPIC_API_KEY=
CUSTOM_ANTHROPIC_BASE_URL=

# Local models (optional)
# http://localhost:11434 (default)
OLLAMA_BASE_URL=

# Web search (optional)
# app.tavily.com
TAVILY_API_KEY=
